# Alpaca API Configuration (Paper Trading)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trading Configuration
DEFAULT_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA
TRADING_MODE=paper
LOG_LEVEL=INFO

# Notification Secrets (enable channels in config.yaml)
# Email (SMTP)
SMTP_USER=
SMTP_PASSWORD=

# Slack webhook URL (get from Slack app settings)
SLACK_WEBHOOK_URL=

# Discord webhook URL (get from Discord channel settings)
DISCORD_WEBHOOK_URL=

# Generic webhook URL (custom endpoint)
NOTIFY_WEBHOOK_URL=
